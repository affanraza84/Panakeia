# ==============================================================================
# Panakeia Medtech — Environment Configuration Example
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (MongoDB Atlas)
# ------------------------------------------------------------------------------
# Connection string to your MongoDB Atlas cluster.
# For serverless environments (Vercel), ensure connection pooling parameters are maintained.
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/panakeia?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/panakeia?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 2. Public Site Configuration
# ------------------------------------------------------------------------------
# Base URL for canonical tags, OpenGraph previews, and sitemap generation.
NEXT_PUBLIC_SITE_URL=https://panakeiamedtech.com

# ------------------------------------------------------------------------------
# 3. Email Notification Service (Resend)
# ------------------------------------------------------------------------------
# API key from Resend (https://resend.com) for dispatching lead notifications.
# In development, if left blank, enquiry leads will log to console without error.
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# Verified sending address in Resend (e.g. enquiries@yourdomain.com)
RESEND_FROM_EMAIL=Panakeia Web <enquiries@panakeiamedtech.com>

# Destination email inbox for incoming hospital procurement / B2B leads
ENQUIRY_NOTIFICATION_EMAIL=panakeia.india@gmail.com

# ------------------------------------------------------------------------------
# 4. On-Demand ISR Revalidation Security
# ------------------------------------------------------------------------------
# Secret token to authorize POST /api/revalidate calls from CMS or admin hooks.
# Pass in request header: `x-revalidate-secret: <REVALIDATE_SECRET>`
REVALIDATE_SECRET=generate_a_random_32_character_hex_or_uuid_string

# ------------------------------------------------------------------------------
# 5. Clerk Authentication
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ------------------------------------------------------------------------------
# 6. Upstash Redis (Optional - for distributed multi-region rate limiting)
# ------------------------------------------------------------------------------
# When traffic scales beyond single-instance memory, set these to activate Upstash Redis.
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...
